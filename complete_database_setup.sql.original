VALUES ('ba709964-b616-4d1f-ae06-b30a682f6b21', 'dibyaprakashkcd1@gmail.com', 'owner', 'Owner', now())
ON CONFLICT (id) DO UPDATE SET 
    role = EXCLUDED.role,
    email = EXCLUDED.email,
